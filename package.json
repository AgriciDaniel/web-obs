{
  "name": "web-obs",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "description": "Obsidian 3D Site Globe plugin and website intelligence crawler (sitemap, content, local images, internal and external links)",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc -b && vite build && node esbuild.config.mjs",
    "build:plugin": "tsc -b && node esbuild.config.mjs",
    "watch:plugin": "OBSIDIAN_PLUGIN_OUTDIR=\".obsidian/plugins/web-obs\" node esbuild.config.mjs watch",
    "install:vault": "npm run build:plugin && node scripts/install-obsidian-plugin.mjs --vault \".\" --enable",
    "verify": "node scripts/verify-all.mjs",
    "release": "node scripts/package-release.mjs",
    "preview": "vite preview --port 4175",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "eslint": "10.14.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.72.1",
    "vite": "^6.2.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgriciDaniel/web-obs.git"
  },
  "bugs": {
    "url": "https://github.com/AgriciDaniel/web-obs/issues"
  },
  "homepage": "https://github.com/AgriciDaniel/web-obs#readme",
  "author": "Daniel Agrici",
  "overrides": {
    "minimatch@>=7": "11.0.1",
    "moment": "2.31.0"
  }
}
